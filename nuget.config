<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Only nuget.org; machine-wide feeds are ignored for this repository. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!-- Every package ID resolves from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
